<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/prime_survey_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    tools:context=".PrimeSurveyActivity">

    <!-- Top and bottom decorative waves matching Tutor Earn identity -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:alpha="0.78"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/prime_survey_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/prime_survey_content_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/prime_survey_responsive_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:layout_constraintWidth_max="600dp">

                <!-- Top Header Bar -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/survey_top_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <FrameLayout
                        android:id="@+id/btn_survey_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/cd_survey_back"
                        android:focusable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_arrow_glass_pill">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_left" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_survey_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/prime_survey_title"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_total_questions"
                        app:layout_constraintStart_toEndOf="@+id/btn_survey_back"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_total_questions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_survey_gold_pill"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="@string/prime_survey_total_questions"
                        android:textColor="@color/gold_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Transparent Test Ad Notice when running in Test Ad Mode -->
                <TextView
                    android:id="@+id/tv_ad_mode_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_survey_gold_pill"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/prime_survey_test_ad_notice"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/survey_top_bar" />

                <!-- Progress Section -->
                <LinearLayout
                    android:id="@+id/survey_progress_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_ad_mode_badge">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_question_counter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/electric_cyan"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Question 1 of 15" />

                        <TextView
                            android:id="@+id/tv_progress_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/gold_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="7%" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/survey_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="15"
                        android:progress="1"
                        app:indicatorColor="@color/gold_primary"
                        app:trackColor="@color/survey_progress_track"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="8dp" />
                </LinearLayout>

                <!-- QUIZ CONTAINER (Questions 1..15) -->
                <LinearLayout
                    android:id="@+id/quiz_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/survey_progress_section">

                    <!-- Question Card -->
                    <LinearLayout
                        android:id="@+id/question_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_survey_card"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="20dp">

                        <TextView
                            android:id="@+id/tv_question_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_survey_badge"
                            android:fontFamily="@font/poppins"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/electric_cyan"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            tools:text="English Grammar" />

                        <TextView
                            android:id="@+id/tv_question_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/montserrat"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Choose the correct sentence that uses the subjunctive mood properly." />
                    </LinearLayout>

                    <!-- Option A -->
                    <LinearLayout
                        android:id="@+id/option_card_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_survey_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="58dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/tv_option_letter_a"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_survey_option_badge"
                            android:fontFamily="@font/montserrat"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_option_text_a"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/white"
                            android:textSize="14.5sp"
                            tools:text="Option A text" />

                        <ImageView
                            android:id="@+id/iv_option_status_a"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option B -->
                    <LinearLayout
                        android:id="@+id/option_card_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_survey_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="58dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/tv_option_letter_b"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_survey_option_badge"
                            android:fontFamily="@font/montserrat"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_option_text_b"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/white"
                            android:textSize="14.5sp"
                            tools:text="Option B text" />

                        <ImageView
                            android:id="@+id/iv_option_status_b"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option C -->
                    <LinearLayout
                        android:id="@+id/option_card_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_survey_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="58dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/tv_option_letter_c"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_survey_option_badge"
                            android:fontFamily="@font/montserrat"
                            android:gravity="center"
                            android:text="C"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_option_text_c"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/white"
                            android:textSize="14.5sp"
                            tools:text="Option C text" />

                        <ImageView
                            android:id="@+id/iv_option_status_c"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option D -->
                    <LinearLayout
                        android:id="@+id/option_card_d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_survey_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="58dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/tv_option_letter_d"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_survey_option_badge"
                            android:fontFamily="@font/montserrat"
                            android:gravity="center"
                            android:text="D"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_option_text_d"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/white"
                            android:textSize="14.5sp"
                            tools:text="Option D text" />

                        <ImageView
                            android:id="@+id/iv_option_status_d"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Feedback Banner after answering -->
                    <LinearLayout
                        android:id="@+id/feedback_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_survey_card"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_feedback_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            tools:text="Correct Answer!" />

                        <TextView
                            android:id="@+id/tv_feedback_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/text_subtitle"
                            android:textSize="12.5sp"
                            tools:text="Explanation text." />
                    </LinearLayout>

                    <!-- Compact Interstitial Ad Loading / Retry Bar (Navy Blue & Gold) -->
                    <LinearLayout
                        android:id="@+id/ad_status_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_survey_ad_compact_card"
                        android:gravity="center_vertical"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/ad_loading_spinner"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:indeterminateTint="@color/gold_primary"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tv_ad_status_message"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins"
                            android:gravity="center"
                            android:text="@string/prime_survey_loading_advertisement"
                            android:textColor="@color/gold_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_retry_ad"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/montserrat"
                            android:insetTop="5dp"
                            android:insetBottom="5dp"
                            android:letterSpacing="0.04"
                            android:minWidth="80dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/prime_survey_ad_retry"
                            android:textColor="@color/navy_deep"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:backgroundTint="@color/gold_primary"
                            app:cornerRadius="19dp" />
                    </LinearLayout>

                    <!-- Next Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_next_question"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp"
                        app:rippleColor="#4DFFFFFF"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_btn_get_started"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="24dp">

                            <TextView
                                android:id="@+id/btn_next_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:text="@string/prime_survey_btn_next"
                                android:textColor="@color/navy_deep"
                                android:textSize="16.5sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/navy_deep" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- COMPLETION & REWARD CLAIM CONTAINER -->
                <LinearLayout
                    android:id="@+id/completion_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_survey_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="26dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/survey_progress_section">

                    <ImageView
                        android:id="@+id/iv_completion_trophy"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:contentDescription="@string/cd_survey_trophy"
                        android:src="@drawable/ic_prime_survey_trophy" />

                    <TextView
                        android:id="@+id/tv_completion_congrats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:text="@string/prime_survey_congratulations"
                        android:textColor="@color/gold_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_completion_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:text="@string/prime_survey_completed_title"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_score_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_survey_badge"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/electric_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Score: 13 / 15 Correct" />

                    <TextView
                        android:id="@+id/tv_reward_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:text="@string/prime_survey_reward_subtitle"
                        android:textColor="@color/text_subtitle"
                        android:textSize="13.5sp" />

                    <!-- Success Banner -->
                    <TextView
                        android:id="@+id/tv_reward_success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_survey_option_correct"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/prime_survey_coins_added"
                        android:textColor="@color/emerald_bright"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- 24-Hour Cooldown Card -->
                    <LinearLayout
                        android:id="@+id/cooldown_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_survey_gold_pill"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/prime_survey_cooldown_title"
                            android:textColor="@color/gold_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_cooldown_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Next claim available in 23:59:42" />
                    </LinearLayout>

                    <!-- Status / Error Message -->
                    <TextView
                        android:id="@+id/tv_claim_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:textColor="@color/auth_error"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Golden CLAIM 1050 COINS Button -->
                    <FrameLayout
                        android:id="@+id/claim_cta_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <View
                            android:id="@+id/btn_claim_glow"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_btn_glow_aura"
                            android:scaleX="1.03"
                            android:scaleY="1.20" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_claim_coins"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="10dp"
                            app:rippleColor="#4DFFFFFF"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_btn_get_started"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingHorizontal="20dp">

                                <ProgressBar
                                    android:id="@+id/claim_progress"
                                    style="?android:attr/progressBarStyleSmall"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="10dp"
                                    android:indeterminateTint="@color/navy_deep"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btn_claim_coins_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat"
                                    android:text="@string/prime_survey_claim_coins"
                                    android:textColor="@color/navy_deep"
                                    android:textSize="16.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <!-- Back to Home Secondary Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_back_to_home"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/prime_survey_back_to_home"
                        android:textColor="@color/white"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="25dp"
                        app:strokeColor="@color/survey_option_border"
                        app:strokeWidth="1.2dp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
