<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".SplashActivity">

    <!-- Top decorative wave accent -->
    <ImageView
        android:id="@+id/splash_wave_top"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:alpha="0.80"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom decorative wave accent -->
    <ImageView
        android:id="@+id/splash_wave_bottom"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Center hero branding group -->
    <LinearLayout
        android:id="@+id/splash_brand_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/splash_loader_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Emblem with radiant backlight aura -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <View
                android:id="@+id/splash_emblem_glow"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_glow" />

            <ImageView
                android:id="@+id/splash_emblem"
                android:layout_width="@dimen/splash_emblem_size"
                android:layout_height="@dimen/splash_emblem_size"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_app_emblem"
                android:src="@drawable/ic_tutor_earn_emblem" />
        </FrameLayout>

        <!-- Two-tone App Name: Tutor Earn + golden burst rays -->
        <LinearLayout
            android:id="@+id/splash_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/splash_title_tutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="10"
                android:text="@string/brand_tutor"
                android:textColor="@color/white"
                android:textSize="@dimen/splash_title_size"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/splash_title_earn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/montserrat"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="10"
                android:text="@string/brand_earn"
                android:textColor="@color/gold_primary"
                android:textSize="@dimen/splash_title_size"
                android:textStyle="bold|italic" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top"
                android:layout_marginStart="2dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brand_burst" />
        </LinearLayout>

        <!-- Tagline -->
        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.06"
            android:text="@string/tagline_learn_complete_earn"
            android:textColor="@color/text_subtitle"
            android:textSize="@dimen/splash_subtitle_size"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <!-- Dual-layer Smooth Loading Ring + Label -->
    <LinearLayout
        android:id="@+id/splash_loader_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splash_brand_container">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_loading_ring_track" />

            <ImageView
                android:id="@+id/splash_loading_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_loading_indicator"
                android:src="@drawable/bg_loading_ring" />
        </FrameLayout>

        <TextView
            android:id="@+id/splash_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.05"
            android:text="@string/loading_label"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
