<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient"
    tools:context=".WelcomeActivity">

    <!-- Top decorative wave accent -->
    <ImageView
        android:id="@+id/welcome_wave_top"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:alpha="0.82"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom decorative wave accent -->
    <ImageView
        android:id="@+id/welcome_wave_bottom"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Responsive ScrollView for small phones, landscape, and tablets -->
    <ScrollView
        android:id="@+id/welcome_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/welcome_content_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/welcome_responsive_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.46"
                app:layout_constraintWidth_max="520dp">

                <!-- Short Welcome Pill -->
                <TextView
                    android:id="@+id/welcome_headline_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_welcome_badge"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.03"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="7dp"
                    android:text="@string/welcome_headline"
                    android:textColor="@color/white"
                    android:textSize="@dimen/welcome_badge_size"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Center 3D Education & Rewards Illustration with Lighting Aura -->
                <FrameLayout
                    android:id="@+id/welcome_illustration_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/welcome_headline_badge">

                    <View
                        android:id="@+id/welcome_hero_glow"
                        android:layout_width="256dp"
                        android:layout_height="256dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_welcome_hero_glow" />

                    <ImageView
                        android:id="@+id/welcome_illustration"
                        android:layout_width="@dimen/welcome_illustration_size"
                        android:layout_height="@dimen/welcome_illustration_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_welcome_illustration"
                        android:src="@drawable/ic_welcome_education_rewards_3d" />
                </FrameLayout>

                <!-- Large Brand Title: Tutor Earn -->
                <LinearLayout
                    android:id="@+id/welcome_title_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/app_name"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/welcome_illustration_group">

                    <TextView
                        android:id="@+id/welcome_title_tutor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="4"
                        android:shadowRadius="10"
                        android:text="@string/brand_tutor"
                        android:textColor="@color/white"
                        android:textSize="@dimen/welcome_title_size"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:id="@+id/welcome_title_earn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="@font/montserrat"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="4"
                        android:shadowRadius="10"
                        android:text="@string/brand_earn"
                        android:textColor="@color/gold_primary"
                        android:textSize="@dimen/welcome_title_size"
                        android:textStyle="bold|italic" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brand_burst" />
                </LinearLayout>

                <!-- Subtitle: Learn • Complete • Earn -->
                <TextView
                    android:id="@+id/welcome_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.06"
                    android:text="@string/tagline_learn_complete_earn"
                    android:textColor="@color/text_subtitle"
                    android:textSize="@dimen/splash_subtitle_size"
                    android:textStyle="bold|italic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/welcome_title_row" />

                <!-- Animated Get Started CTA Button with Ambient Glow -->
                <FrameLayout
                    android:id="@+id/welcome_cta_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/welcome_subtitle"
                    app:layout_constraintWidth_max="340dp">

                    <View
                        android:id="@+id/btn_get_started_glow"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/welcome_button_height"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/bg_btn_glow_aura"
                        android:scaleX="1.05"
                        android:scaleY="1.26" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_get_started"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/welcome_button_height"
                        android:clickable="true"
                        android:contentDescription="@string/cd_get_started_button"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="10dp"
                        app:rippleColor="#4DFFFFFF"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_btn_get_started"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="24dp">

                            <TextView
                                android:id="@+id/btn_get_started_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:letterSpacing="0.02"
                                android:text="@string/get_started"
                                android:textColor="@color/navy_deep"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="10dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/navy_deep" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
