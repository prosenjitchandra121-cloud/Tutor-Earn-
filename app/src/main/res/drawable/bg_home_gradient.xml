<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#050A30"
                android:centerColor="#0B1554"
                android:endColor="#190A4A"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.2"
                android:centerY="0.1"
                android:gradientRadius="260dp"
                android:startColor="#381D4ED8"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
