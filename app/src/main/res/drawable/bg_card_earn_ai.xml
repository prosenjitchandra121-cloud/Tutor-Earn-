<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius" />
            <gradient
                android:angle="315"
                android:startColor="@color/earn_ai_start"
                android:centerColor="@color/earn_ai_center"
                android:endColor="@color/earn_ai_end"
                android:type="linear" />
            <stroke
                android:width="1.6dp"
                android:color="@color/glass_border_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius" />
            <gradient
                android:centerX="0.5"
                android:centerY="0.32"
                android:gradientRadius="130dp"
                android:startColor="#48FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
